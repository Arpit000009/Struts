<project name="LibraryDev" default="war" basedir=".">

    <!-- ===== Properties ===== -->

    <property name="src.dir" value="src"/>
    <property name="web.dir" value="src/main/webapp"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="dist.dir" value="${build.dir}/dist"/>
    <property name="lib.dir" value="src/main/webapp/WEB-INF/lib"/>
    
    
    <property name="tomcat.dir" value="A:\apache-tomcat-9.0.115"/>

<target name="deploy" depends="war">

    <copy file="${dist.dir}/${war.name}"
          todir="${tomcat.dir}/webapps"/>

</target>
    

    <!-- WAR name -->
    <property name="war.name" value="librarydev.war"/>

    <!-- ===== Clean ===== -->

    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>

    <!-- ===== Init ===== -->

    <target name="init">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <!-- ===== Compile Java ===== -->

	<target name="compile" depends="clean,init">

	    <javac srcdir="${src.dir}"
	           destdir="${classes.dir}"
	           includeantruntime="false"
	           debug="true">

	        <classpath>
	            <fileset dir="${lib.dir}" includes="*.jar"/>
	        </classpath>

	    </javac>

	    <!-- Copy resources like struts.xml -->
	    <copy todir="${classes.dir}">
	        <fileset dir="src/main/resources"/>
	    </copy>

	</target>

    <!-- ===== Create WAR ===== -->

    <target name="war" depends="compile">

        <war destfile="${dist.dir}/${war.name}" webxml="${web.dir}/WEB-INF/web.xml">

            <!-- compiled classes -->
            <classes dir="${classes.dir}"/>

            <!-- JSP and web files -->
            <fileset dir="${web.dir}"/>

            <!-- libraries -->
            <lib dir="${lib.dir}"/>

        </war>

    </target>

</project>